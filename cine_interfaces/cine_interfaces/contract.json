    },
    {
      "key": "mavros_raw_setpoint",
      "description": "Position targets the orbit node sends straight to MAVROS, bypassing the setpoint relay.",
      "message_type": "mavros_msgs/msg/PositionTarget",
      "direction": "ground_to_pi",
      "accepted_mismatch": false,
      "modes": ["hardware"],
      "publishers": [
        {
          "repository": "CINE",
          "node": "orbit_waypoint_generator",
          "topic": "/mavros/setpoint_raw/local",
          "source": {
            "kind": "code",
            "file": "cine_agent/cine_agent/setpoint_adjustment/nodes/orbit_waypoint_generator_node.py"
          }
        }
      ],
      "subscribers": [
        {
          "repository": "external",
          "node": "mavros",
          "topic": "/mavros/setpoint_raw/local",
          "source": {
            "kind": "unchecked",
            "reason": "MAVROS runs on the Pi but belongs to neither repository"
