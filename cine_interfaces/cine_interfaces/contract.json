    {
      "key": "setpoint_attitude_position",
      "description": "Drone attitude setpoints the Pi relays to MAVROS. Nothing in CINE publishes them yet.",
      "message_type": "geometry_msgs/msg/PoseStamped",
      "direction": "ground_to_pi",
      "accepted_mismatch": true,
      "modes": ["hardware", "sim"],
      "publishers": [],
      "subscribers": [
        {
          "repository": "CINE-Sensing",
          "node": "mavros_setpoints",
          "topic": "/cinematography/attitude_position_setpoints",
          "source": {
            "kind": "code",
            "file": "cine_sensing_setpoint/cine_sensing_setpoint/mavros_setpoints.py"
          }
        }
      ]
    },
    {
      "key": "setpoint_attitude_velocity",
      "description": "Drone attitude rate setpoints the Pi relays to MAVROS. Nothing in CINE publishes them yet.",
      "message_type": "geometry_msgs/msg/TwistStamped",
      "direction": "ground_to_pi",
      "accepted_mismatch": true,
      "modes": ["hardware", "sim"],
      "publishers": [],
      "subscribers": [
        {
          "repository": "CINE-Sensing",
          "node": "mavros_setpoints",
          "topic": "/cinematography/attitude_velocity_setpoints",
          "source": {
            "kind": "code",
