<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cine_interfaces</name>
  <version>0.1.0</version>
  <description>The contract for every ROS 2 topic that crosses Wi-Fi between CINE-Sensing on the drone and CINE on the ground PC, with checks that compare it against code, config and a running graph.</description>
  <maintainer email="fishnos@users.noreply.github.com">fishnos</maintainer>
  <license>GPL-3.0-only</license>
  <url type="repository">https://github.com/Kino-Studios/CINE-Interfaces</url>
  <url type="bugtracker">https://github.com/Kino-Studios/CINE-Interfaces/issues</url>

  <exec_depend>ros2cli</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>ros2topic</test_depend>
  <test_depend>std_msgs</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
